      "task_id": "ripgrep-4df129812769",
      "title": "globset: fix bug where trailing `.` in file name was incorrectly handled",
      "base_sha": "ba23ced8178496263af013117b70c09ce39c18e5",
      "fix_sha": "4df1298127695ed1e76937f16de1a0135677ccf5",
      "test_files": [
        "tests/regression.rs"
      ],
      "source_files": [
        "crates/globset/src/pathutil.rs"
      ],
      "source_url": "https://github.com/BurntSushi/ripgrep/commit/4df1298127695ed1e76937f16de1a0135677ccf5",
      "test_selectors": [],
      "cargo_package": "ripgrep",
      "cargo_tests": [
        "integration"
      ],
      "regression_scope": {
        "kind": "cargo-package-tests",
        "package": "ripgrep"
      },
      "required_regression_tests": [
        "integration::regression::r2990_trip_over_trailing_dot"
      ],
      "test_adaptations": [
        {
          "platform": "win32",
          "path": "tests/regression.rs",
          "upstream_sha256": "48708bd6aa3534e703a11b101de09a66794206ffc043be966abba3cfde07801e",
          "adapted_sha256": "5af7651c1b41e9f16ef45b4ca2bb523287b956d75ba480337111d0c40958edf0",
          "replacements": [
            {
              "old": "// See: https://github.com/BurntSushi/ripgrep/issues/2990\n#[cfg(unix)]\nrgtest!(r2990_trip_over_trailing_dot, |dir: Dir, _cmd: TestCommand| {\n    dir.create_dir(\"asdf\");\n    dir.create_dir(\"asdf.\");\n    dir.create(\"asdf/foo\", \"\");\n    dir.create(\"asdf./foo\", \"\");\n\n    let got = dir.command().args(&[\"--files\", \"-g\", \"!asdf/\"]).stdout();\n    eqnice!(\"asdf./foo\\n\", got);\n\n    // This used to ignore the glob given and included `asdf./foo` in output.\n    let got = dir.command().args(&[\"--files\", \"-g\", \"!asdf./\"]).stdout();\n    eqnice!(\"asdf/foo\\n\", got);\n});\n",
              "new": "// See: https://github.com/BurntSushi/ripgrep/issues/2990\n// SWE Windows fixture: exercise the same override matcher without creating\n// trailing-dot directory names that Win32 normalizes on filesystem access.\nrgtest!(r2990_trip_over_trailing_dot, |dir: Dir, _cmd: TestCommand| {\n    let mut plain = ignore::overrides::OverrideBuilder::new(dir.path());\n    plain.add(\"!asdf/\").unwrap();\n    let plain = plain.build().unwrap();\n    assert!(plain.matched(dir.path().join(\"asdf\"), true).is_ignore());\n    assert!(!plain.matched(dir.path().join(\"asdf.\"), true).is_ignore());\n\n    let mut dotted = ignore::overrides::OverrideBuilder::new(dir.path());\n    dotted.add(\"!asdf./\").unwrap();\n    let dotted = dotted.build().unwrap();\n    assert!(dotted.matched(dir.path().join(\"asdf.\"), true).is_ignore());\n    assert!(!dotted.matched(dir.path().join(\"asdf\"), true).is_ignore());\n});\n"
            }
          ]
        }
      ]
    },
